# Service Port and Host
PORT=8000
ENVIRONMENT=development

# Upstream Database Service URL (optional for offline testing)
DB_API_BASE_URL=https://eiacommonfastapi-production.up.railway.app

# OpenAI Configuration
OPENAI_API_KEY=
PRESENTATION_LLM_MODEL=gpt-4o
PRESENTATION_LLM_TIMEOUT=90
PRESENTATION_LLM_RETRIES=1
PRESENTATION_LLM_CACHE_DIR=local_test_output/.llm_cache

# Worker Settings
PRESENTATION_MAX_JOBS=2
PRESENTATION_JOB_DEADLINE=1500

